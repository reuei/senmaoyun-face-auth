{
    "name": "senmaoyun/realperson-auth",
    "description": "森码云实人认证系统 - 企业级人机验证/实人认证平台",
    "type": "project",
    "keywords": ["face-recognition", "liveness-detection", "real-person-auth", "魔方财务"],
    "license": "MIT",
    "require": {
        "php": ">=8.1.0",
        "topthink/framework": "^6.0",
        "topthink/think-orm": "^2.0",
        "topthink/think-view": "^1.0",
        "guzzlehttp/guzzle": "^7.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "tencentcloud/tencentcloud-sdk-php": "^3.0",
        "phpmailer/phpmailer": "^6.0",
        "endroid/qr-code": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}